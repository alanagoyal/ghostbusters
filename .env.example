# Copy to .env. Never commit credentials.
# Choose a generic RTSP/HTTP stream, USB index (0), or leave blank for DoorBird.
CAMERA_SOURCE=
DOORBIRD_IP=
DOORBIRD_USERNAME=
DOORBIRD_PASSWORD=

# Optional detection region, normalized 0..1.
# If omitted: generic sources use full frame; DoorBird uses x=0..0.7.
# ROI_X_MIN=0
# ROI_X_MAX=1
# ROI_Y_MIN=0
# ROI_Y_MAX=1

# Baseten costume classification. The setup wizard supplies hosted API defaults.
BASETEN_API_KEY=
BASETEN_MODEL_URL=
# For hosted Model APIs: URL=https://inference.baseten.co/v1/chat/completions
# BASETEN_MODEL=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B
# BASETEN_AUTH_SCHEME=Bearer
# Dedicated legacy deployments default to model=gemma, auth=Api-Key.

# Supabase database, image storage, and live dashboard.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEVICE_ID=front-door

# false keeps new captures on the capture computer, out of the cloud gallery.
# Reloaded each capture; set true to publish only subsequent captures.
PUBLISH_DETECTIONS=true

# New Stripe Projects installs: use `ghostbusters projects configure`.
# Existing Baseten installs should retain their current values.
# INFERENCE_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=an-explicit-reviewed-vision-model
# GALLERY_ACCESS=private
# Private mode requires the Projects bootstrap + viewer setup, not the legacy schema.
