NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Keep /ghostbusters for the original deployment, or leave empty for root hosting.
NEXT_PUBLIC_BASE_PATH=/ghostbusters

# New cloud galleries use private storage and explicit viewer accounts.
NEXT_PUBLIC_GALLERY_ACCESS=private
NEXT_PUBLIC_SOURCE_URL=https://github.com/alanagoyal/ghostbusters

# Optional public gallery copy, baked into the frontend at build time.
# Leave blank for generic defaults. Never put credentials or camera URLs here.
NEXT_PUBLIC_GALLERY_SUBTITLE=
NEXT_PUBLIC_GALLERY_OFFLINE_MESSAGE=
NEXT_PUBLIC_GALLERY_CAPTURE_TEXT=
NEXT_PUBLIC_GALLERY_DETECT_TEXT=
NEXT_PUBLIC_GALLERY_FILTER_TEXT=
NEXT_PUBLIC_GALLERY_CLASSIFY_TEXT=
NEXT_PUBLIC_GALLERY_PUBLISH_TEXT=
